# Copia este archivo a `.env` y ajusta los valores.
# Los valores por defecto son los nombres de los servicios en la red de Docker
# del docker-compose de pdf-extractext-orchestration.

EXTRACTOR_URL=http://extractor:8000
SUMMARIZER_URL=http://summarizer:8000
SUMMARIES_URL=http://summaries:8000
EXPORTER_URL=http://exporter:8000

# Segundos de espera a extractor, summaries y exporter antes de responder 504.
SERVICE_TIMEOUT_SECONDS=10
# El resumen espera a la IA: más margen que el timeout del propio summarizer (60 s).
SUMMARIZER_TIMEOUT_SECONDS=90
